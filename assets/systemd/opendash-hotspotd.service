[Unit]
Description=OpenDash Hotspot Control Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/opendash-hotspotd
Restart=on-failure
User=root
Group=root
RuntimeDirectory=opendash
RuntimeDirectoryMode=0755
Environment=OPENDASH_HOTSPOTD_SOCKET=/run/opendash/hotspotd.sock

[Install]
WantedBy=multi-user.target
